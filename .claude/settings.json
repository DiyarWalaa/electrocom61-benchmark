{
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(mv *)",
      "PowerShell(rm *)",
      "PowerShell(rmdir *)",
      "PowerShell(del *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Rename-Item *)",
      "PowerShell(Clear-Content *)",

      "Bash(git rm *)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git checkout --detach*)",
      "Bash(git checkout -- *)",
      "Bash(git commit --amend *)",
      "Bash(git filter-branch *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git clone *)",
      "PowerShell(git rm *)",
      "PowerShell(git clean *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git rebase *)",
      "PowerShell(git checkout --detach*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git commit --amend *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git clone *)",

      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python -m pip *)",
      "Bash(conda *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(mpm *)",
      "Bash(miktex *)",
      "PowerShell(pip *)",
      "PowerShell(pip3 *)",
      "PowerShell(python -m pip *)",
      "PowerShell(conda *)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(winget *)",
      "PowerShell(choco *)",
      "PowerShell(Install-Module *)",
      "PowerShell(Install-Package *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Start-BitsTransfer *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(mpm *)",
      "PowerShell(miktex *)",

      "PowerShell(powershell -File scripts\\build_paper.ps1 -AllowInstall*)",
      "PowerShell(powershell -NoProfile -File scripts\\build_paper.ps1 -AllowInstall*)",

      "Read(~/**)",
      "Edit(~/**)",
      "Write(~/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["scripts/deny_guard.py"],
            "timeout": 10,
            "statusMessage": "checking command against deny list"
          }
        ]
      }
    ]
  }
}
