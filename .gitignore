# ---------------------------------------------------------------------------
# Datasets -- NEVER committed.
#
# Both dataset versions are publicly archived (see README.md) and are large
# binary blobs that git handles badly. They are inputs to this study, not
# products of it, so they are reproduced by download instruction rather than
# stored here. Excluding the whole directory also covers the metadata CSV,
# which ships inside the dataset archives.
# ---------------------------------------------------------------------------
data/

# The corrected-split tree built by scripts/build_corrected_dataset.py. Already
# covered by `data/` above; named explicitly because it is GENERATED rather than
# downloaded, and a reader checking "is my rebuilt dataset excluded?" should be
# able to find the answer by searching for it. Rebuild it with that script from
# runs/20260803_corrected_split_02/split_manifest.csv rather than committing
# 146 MB of images that are byte-identical to v2's.
data/ElectroCom-61_corrected/

# ---------------------------------------------------------------------------
# Python bytecode -- regenerated on every run, machine-specific.
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Per-machine tool permissions. Not part of the study and not portable to
# another checkout. CLAUDE.md (the actual project rules) IS committed.
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------------------
# OS / editor droppings.
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
